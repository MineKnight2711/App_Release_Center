{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amc-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      // Shared with the amc-relay Worker; this Worker owns only the tables in ./migrations.
      "binding": "DB",
      "database_name": "amc-relay",
      "database_id": "bddc397e-d8d1-4383-bebf-b2eab4b49a1a",
      "migrations_dir": "migrations",
      "migrations_table": "amc_api_migrations"
    }
  ],
  // Workers AI: the release note fallback when the app's Gemini quota runs out.
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    {
      "name": "ANALYTICS_LIMITER",
      "namespace_id": "4104",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AI_LIMITER",
      "namespace_id": "4102",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      // Opening a safe share link, per link and address.
      "name": "SHARE_LIMITER",
      "namespace_id": "4103",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
  // Secret (not committed): PASSWORD_PEPPER — set with `npx wrangler secret put PASSWORD_PEPPER`,
  // and in .dev.vars for `wrangler dev`.
}
