rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid);
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function invitePath(teamId, inviteId) {
      return /databases/$(database)/documents/teams/$(teamId)/invites/$(inviteId);
    }

    function isActiveMember(teamId) {
      return signedIn() &&
        exists(memberPath(teamId)) &&
        get(memberPath(teamId)).data.status == 'active';
    }

    function role(teamId) {
      return get(memberPath(teamId)).data.role;
    }

    function canEditApiTools(teamId) {
      return isActiveMember(teamId) && role(teamId) in ['admin', 'dev'];
    }

    function isAdmin(teamId) {
      return isActiveMember(teamId) && role(teamId) == 'admin';
    }

    function isBootstrapAdminCreate(teamId, uid) {
      return signedIn() &&
        uid == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.role == 'admin' &&
        getAfter(teamPath(teamId)).data.createdByUid == request.auth.uid;
    }

    function isInviteMemberCreate(teamId, uid) {
      let inviteId = request.resource.data.joinedViaInviteId;
      return signedIn() &&
        uid == request.auth.uid &&
        inviteId is string &&
        request.resource.data.status == 'active' &&
        getAfter(invitePath(teamId, inviteId)).data.status == 'used' &&
        getAfter(invitePath(teamId, inviteId)).data.usedByUid == request.auth.uid &&
        getAfter(invitePath(teamId, inviteId)).data.role == request.resource.data.role;
    }

    function isInviteUse() {
      return signedIn() &&
        resource.data.status == 'active' &&
        resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time &&
        request.resource.data.status == 'used' &&
        request.resource.data.usedByUid == request.auth.uid &&
        request.resource.data.usedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'usedByUid', 'usedAt']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || request.auth.uid != null);
      allow create, update: if signedIn() && uid == request.auth.uid;
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isAdmin(teamId);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isActiveMember(teamId);
        allow create: if isAdmin(teamId) ||
          isBootstrapAdminCreate(teamId, uid) ||
          isInviteMemberCreate(teamId, uid);
        allow update, delete: if isAdmin(teamId);
      }

      match /invites/{inviteId} {
        allow read: if signedIn();
        allow create, delete: if isAdmin(teamId);
        allow update: if isAdmin(teamId) || isInviteUse();
      }

      match /apiToolCollections/{collectionId} {
        allow read: if isActiveMember(teamId);
        allow write: if canEditApiTools(teamId);
      }

      match /apiToolFolders/{folderId} {
        allow read: if isActiveMember(teamId);
        allow write: if canEditApiTools(teamId);
      }

      match /apiToolRequests/{requestId} {
        allow read: if isActiveMember(teamId);
        allow write: if canEditApiTools(teamId);
      }

      match /apiToolQuickRequests/{quickRequestId} {
        allow read: if isActiveMember(teamId);
        allow write: if canEditApiTools(teamId);
      }

      // QA Desk demo-account vault. Account secrets are encrypted on the
      // client with the team passphrase; these rules decide who may read the
      // ciphertext, who may change it, and who may hold an account.
      match /qaVault/{docId} {
        allow read: if isActiveMember(teamId);
        allow write: if isAdmin(teamId);
      }

      match /qaAccounts/{accountId} {
        allow read: if isActiveMember(teamId);
        allow write: if isAdmin(teamId);
      }

      // The last login result, written by whoever ran with the account.
      match /qaAccountStatus/{accountId} {
        allow read, write: if isActiveMember(teamId);
      }

      // A lease is taken or renewed only in one's own name, and only while
      // it is free, already one's own, or expired by server time.
      match /qaAccountLeases/{accountId} {
        allow read: if isActiveMember(teamId);
        allow create: if isActiveMember(teamId) &&
          request.resource.data.holderUid == request.auth.uid;
        allow update: if isActiveMember(teamId) &&
          request.resource.data.holderUid == request.auth.uid &&
          (resource.data.holderUid == request.auth.uid ||
            resource.data.expiresAt < request.time);
        allow delete: if isActiveMember(teamId) &&
          (resource.data.holderUid == request.auth.uid ||
            resource.data.expiresAt < request.time);
      }

      // Append-only: who changed, revealed or used which account.
      match /qaAccountAudit/{eventId} {
        allow read: if isAdmin(teamId);
        allow create: if isActiveMember(teamId) &&
          request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
